---
import '../styles/global.css';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  // OGP 画像（public/ からのパス）
  image?: string;
}
const { title, description = SITE.description, image } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.author}`;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ja" data-endpoint={SITE.endpoint}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="sitemap" href={`${base}sitemap.xml`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={new URL(`${base}${image}`, Astro.site)} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content="#024176" />
    <!-- 背景は常に白。Dark Reader 等の拡張機能による自動ダーク化を止める -->
    <meta name="darkreader-lock" />
  </head>
  <body>
    <!-- 背景の丸（アイコンと同じ色面。ページの端で一部だけ見える。装飾のみ） -->
    <div class="circles" aria-hidden="true">{Array.from({ length: 5 }, () => <span />)}</div>
    <header class="site"><div class="wrap"><a href={base}>{SITE.name}</a></div></header>
    <main class="wrap"><slot /></main>
    <footer class="site">
      <div class="wrap">
        <nav>
          <span>{SITE.author}</span>
          <a href={SITE.github}>GitHub</a>
        </nav>
      </div>
    </footer>
    <script src="../scripts/track.ts"></script>
  </body>
</html>
