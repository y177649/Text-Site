---
import { assetUrl, catStyle, isNew, textUrl, type Text } from '../lib/texts';
import RubyTitle from './RubyTitle.astro';

interface Props {
  text: Text;
}
const { text } = Astro.props;
const { category, summary, image, parts, level } = text.data;
---
<li class="card" style={catStyle(category)}>
  {isNew(text) && <span class="new-badge">New</span>}
  {image && <img class="thumb" src={assetUrl(image)} alt="" loading="lazy" decoding="async" />}
  <div class="card-body">
    <div class="meta"><span class="tag">{category}</span>{level && <span class="stars" aria-label={`難しさ ${level}（4段階）`}>{'⭐'.repeat(level)}</span>}{parts && <span class="parts">{parts}パーツ</span>}</div>
    <h3><a href={textUrl(text)}><RubyTitle text={text} /></a></h3>
    <p>{summary}</p>
  </div>
</li>
