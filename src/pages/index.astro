---
import Base from '../layouts/Base.astro';
import TextCard from '../components/TextCard.astro';
import { assetUrl, catStyle, categoryUrl, getTexts, groupByCategory, newTexts, rankedTexts, toolSummary } from '../lib/texts';
import { SITE } from '../site';

const texts = await getTexts();
const groups = groupByCategory(texts);
const fresh = newTexts(texts); // 公開から SITE.newDays 日以内。0件なら欄ごと出さない
const ranked = await rankedTexts(texts); // よく開かれている順。取れなければ欄ごと出さない
const tools = toolSummary(texts);
---
<Base>
  <section class="hero">
    <h1>{SITE.headline}</h1>
    <p class="lead">はじめての子も、もっと作りたい子も。</p>
  </section>

  <!-- 分類の入口。押すとその分類の全テキストのページへ。分類が増えれば自動で増える -->
  <nav class="entries" aria-label="分類を選ぶ">
    {groups.map((g) => {
      const imgs = g.texts.map((t) => t.data.image).filter(Boolean).slice(0, 4) as string[];
      return (
        <a class="entry" href={categoryUrl(g.name, g.index)} style={catStyle(g.name)}>
          <span class={`entry-imgs n${imgs.length}`}>
            {imgs.map((img) => <img src={assetUrl(img)} alt="" loading="lazy" decoding="async" />)}
          </span>
          <span class="entry-name">{g.name}のテキスト</span>
          <span class="entry-count">{g.name}の全てのテキストはこちら →</span>
        </a>
      );
    })}
  </nav>

  {fresh.length > 0 && (
    <>
      <h2 id="new">New</h2>
      <p class="note">公開から{SITE.newDays}日以内のテキスト。</p>
      <ul class="grid">
        {fresh.map((text) => <TextCard text={text} />)}
      </ul>
    </>
  )}

  {ranked && (
    <>
      <h2 id="recommend">おすすめのテキスト</h2>
      <p class="note">よく開かれているテキスト。</p>
      <ul class="grid">
        {ranked.map((text) => <TextCard text={text} />)}
      </ul>
    </>
  )}

  <div class="two-col">
    <section>
      <h2 id="about">About</h2>
      <ul class="facts">{SITE.about.map((a) => <li>{a}</li>)}</ul>
    </section>
    <section>
      <h2 id="tools">使う道具・ソフト</h2>
      <ul class="chips">
        {tools.map((t) => <li>{t.name}<span>{t.count}</span></li>)}
      </ul>
    </section>
  </div>
</Base>
