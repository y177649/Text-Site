---
import Base from '../layouts/Base.astro';
import TextCard from '../components/TextCard.astro';
import { assetUrl, catStyle, getTexts, groupByCategory, toolSummary } from '../lib/texts';
import { SITE } from '../site';

const texts = await getTexts();
const groups = groupByCategory(texts); // 分類ごと。全件
const tools = toolSummary(texts);
---
<Base>
  <section class="hero">
    <h1>{SITE.headline}</h1>
    <p class="lead">はじめての子も、もっと作りたい子も。</p>
  </section>

  <!-- 分類の入口。押すと下の一覧のその分類へ飛ぶ。分類が増えれば自動で増える -->
  <nav class="entries" aria-label="分類を選ぶ">
    {groups.map((g) => {
      const img = g.texts.find((t) => t.data.image)?.data.image;
      return (
        <a class="entry" href={`#cat-${g.index}`} style={catStyle(g.name)}>
          {img && <img src={assetUrl(img)} alt="" loading="lazy" decoding="async" />}
          <span class="entry-name">{g.name}</span>
          <span class="entry-count">{g.texts.length}本 →</span>
        </a>
      );
    })}
  </nav>

  <h2 id="texts">すべてのテキスト</h2>
  <p class="note">分類ごとの一覧。</p>
  {groups.map((g) => (
    <>
      <h3 class="cat-heading" id={`cat-${g.index}`} style={catStyle(g.name)}>{g.name}</h3>
      <ul class="grid">
        {g.texts.map((text) => <TextCard text={text} />)}
      </ul>
    </>
  ))}

  <div class="two-col">
    <section>
      <h2 id="about">About</h2>
      <ul class="facts">{SITE.about.map((a) => <li>{a}</li>)}</ul>
    </section>
    <section>
      <h2 id="tools">使う道具・ソフト</h2>
      <p class="note">上のテキストで使うもの。数字は使うテキストの数。</p>
      <ul class="chips">
        {tools.map((t) => <li>{t.name}<span>{t.count}</span></li>)}
      </ul>
    </section>
  </div>
</Base>
