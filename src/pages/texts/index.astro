---
// 一覧はトップに移した（2026-11-10）。前のURL（社内で共有したリンクなど）から来た人をトップの一覧へ送る
const to = `${import.meta.env.BASE_URL}#texts`;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <title>すべてのテキスト</title>
  </head>
  <body><p><a href={to}>すべてのテキストはトップページにあります →</a></p></body>
</html>
