---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RubyTitle from '../../components/RubyTitle.astro';
import { SITE } from '../../site';
import { assetUrl, catStyle, formUrl, getTexts, groupByCategory, textUrl } from '../../lib/texts';

export async function getStaticPaths() {
  const texts = await getTexts();
  const groups = groupByCategory(texts);
  return texts.map((text, i) => ({
    params: { slug: text.id },
    props: {
      text,
      prev: texts[i - 1],
      next: texts[i + 1],
      catIndex: groups.find((g) => g.name === text.data.category)!.index,
    },
  }));
}

const { text, prev, next, catIndex } = Astro.props;
const { title, category, summary, image, url, video, tools, parts, level, techTags } = text.data;
const { Content } = await render(text);
// 本文（Markdown）は備考だけ。空なら「-」
const hasNote = (text.body ?? '').trim().length > 0;
const lv = level ? SITE.levels.find((l) => l.stars === level) : undefined;
---
<Base title={title} description={summary} image={image}>
  <article style={catStyle(category)}>
    <a class="back" href={`${import.meta.env.BASE_URL}texts/#cat-${catIndex}`}>← すべてのテキスト</a>
    <h1><RubyTitle text={text} /></h1>
    <p class="lead">{summary}</p>
    {image && <img class="hero-image" src={assetUrl(image)} alt={`${title}の完成イメージ`} />}
    <dl>
      <dt>分類</dt><dd>{category}</dd>
      <dt>難しさ</dt><dd>{lv ? (
        <details class="level-pick">
          <summary><span class="stars" aria-label={`難しさ ${lv.stars}（4段階）。押すと目安が開く`}>{'⭐'.repeat(lv.stars)}</span></summary>
          <ul>
            {SITE.levels.map((l) => <li class={l.stars === lv.stars ? 'is-current' : undefined}><span class="stars">{'⭐'.repeat(l.stars)}</span>{l.label}（{l.minutes}分くらい）</li>)}
          </ul>
        </details>
      ) : '-'}</dd>
      <dt>制作時間</dt><dd>{lv ? `${lv.minutes}分くらい` : '-'}</dd>
      <dt>パーツ数</dt><dd class="parts-count">{parts ? `${parts}パーツ` : '-'}</dd>
      <dt>技術</dt><dd>{techTags.length > 0 ? <span class="tech-tags">{techTags.map((t) => <span>#{t}</span>)}</span> : '-'}</dd>
      {tools.length > 0 && <><dt>使うもの</dt><dd>{tools.join(' / ')}</dd></>}
    </dl>
    <!-- data-text-id の付いたリンクを押したときだけ利用を記録する（src/scripts/track.ts） -->
    {url
      ? <a class="open" href={url} target="_blank" rel="noopener noreferrer" data-text-id={text.id}>テキストを開く →</a>
      : <span class="open is-disabled">テキストは準備中</span>}
    <section class="demo">
      <h2>動くようす</h2>
      {video
        ? <video src={assetUrl(video)} muted autoplay loop playsinline controls preload="metadata" aria-label={`${title}が動くようす`} />
        : <p class="no-video">動画なし</p>}
    </section>
    <section class="note">
      <h2>備考</h2>
      {hasNote ? <div class="body"><Content /></div> : <p>-</p>}
    </section>
    {formUrl() && (
      <section class="ask">
        <h2>このテキストについて連絡する</h2>
        <div class="ask-buttons">
          {SITE.form.kinds.map((kind) => <a class="ask-button" href={formUrl(kind, title)} target="_blank" rel="noopener noreferrer">{kind}</a>)}
        </div>
      </section>
    )}
    <nav class="pager" aria-label="ほかのテキスト">
      {prev ? <a href={textUrl(prev)}>← <RubyTitle text={prev} /></a> : <span />}
      {next ? <a href={textUrl(next)}><RubyTitle text={next} /> →</a> : <span />}
    </nav>
  </article>
</Base>

<script>
  // 動きを減らす設定の端末では、動画を自動再生しない（再生ボタンで見られる）
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('video[autoplay]').forEach((v) => (v as HTMLVideoElement).pause());
  }
</script>
